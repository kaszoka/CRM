<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRM POLA - Zmień hasło</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #0f172a;
            background-image: radial-gradient(circle at 0 0, rgba(56, 189, 248, 0.12), transparent 55%),
                              radial-gradient(circle at 100% 100%, rgba(129, 140, 248, 0.14), transparent 55%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
            color: #e2e8f0;
            padding: 16px;
        }
        @media (max-width: 480px) {
            body { align-items: flex-start; padding-top: 32px; }
            .cp-card { padding: 20px 16px; }
        }
        .cp-wrapper {
            width: 100%;
            max-width: 520px;
        }
        .cp-card {
            background: rgba(15, 23, 42, 0.9);
            border-radius: 16px;
            border: 1px solid rgba(148, 163, 184, 0.35);
            padding: 24px 26px 22px;
            box-shadow: 0 24px 80px rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(22px);
        }
        .cp-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }
        .cp-icon {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #22d3ee, #6366f1);
            color: #0f172a;
        }
        .cp-title {
            font-size: 17px;
            font-weight: 600;
            color: #e5e7eb;
        }
        .cp-subtitle {
            font-size: 13px;
            color: #9ca3af;
            margin-bottom: 14px;
        }
        .cp-subtitle-strong {
            font-weight: 600;
            color: #e5e7eb;
        }
        .cp-guidelines {
            font-size: 12px;
            color: #9ca3af;
            margin-bottom: 18px;
            border-radius: 12px;
            border: 1px dashed rgba(148, 163, 184, 0.5);
            padding: 10px 12px;
            background: radial-gradient(circle at 0 0, rgba(59, 130, 246, 0.14), transparent 65%);
        }
        .cp-guidelines ul {
            padding-left: 18px;
            margin: 6px 0 0;
        }
        .cp-guidelines li {
            margin-bottom: 3px;
        }
        .cp-form-group { margin-bottom: 14px; }
        .cp-form-group label {
            font-size: 13px;
            font-weight: 500;
            color: #e5e7eb;
            margin-bottom: 4px;
            display: block;
        }
        .cp-form-group input {
            width: 100%;
            border-radius: 10px;
            border: 1px solid #1f2937;
            padding: 9px 12px;
            font-size: 13px;
            background: #020617;
            color: #f9fafb;
        }
        .cp-form-group input:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.8);
        }
        .cp-form-group input::placeholder {
            color: #6b7280;
        }
        .cp-error {
            margin-top: 6px;
            font-size: 12px;
            color: #fb7185;
        }
        .cp-actions {
            margin-top: 16px;
            display: flex;
            justify-content: flex-end;
        }
        .cp-submit {
            border-radius: 10px;
            border: none;
            padding: 9px 18px;
            font-size: 13px;
            font-weight: 600;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: #052e16;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .cp-submit:hover {
            background: linear-gradient(135deg, #4ade80, #22c55e);
        }
    </style>
</head>
<body>
    <div class="cp-wrapper">
        <div class="cp-card">
            <div class="cp-header">
                <div class="cp-icon">
                    <i class="fa fa-key"></i>
                </div>
                <div class="cp-title">
                    Ustaw swoje nowe hasło
                </div>
            </div>
            <div class="cp-subtitle">
                {% if mustChangePassword %}
                    <span class="cp-subtitle-strong">To Twoje pierwsze logowanie.</span>
                    Ze względów bezpieczeństwa prosimy o ustawienie własnego hasła dostępu.
                {% else %}
                    Zmień hasło do swojego konta.
                {% endif %}
            </div>
            <div class="cp-guidelines">
                <span class="cp-subtitle-strong">Minimalne wytyczne bezpieczeństwa:</span>
                <ul>
                    <li>co najmniej 8 znaków,</li>
                    <li>przynajmniej jedna mała i jedna wielka litera,</li>
                    <li>przynajmniej jedna cyfra,</li>
                    <li>przynajmniej jeden znak specjalny (np. ! @ # ? ).</li>
                </ul>
            </div>

            {{ form_start(changePasswordForm) }}
                <div class="cp-form-group">
                    {{ form_label(changePasswordForm.password.first) }}
                    {{ form_widget(changePasswordForm.password.first) }}
                    {% if changePasswordForm.password.first.vars.errors|length > 0 %}
                        <div class="cp-error">
                            {{ changePasswordForm.password.first.vars.errors|first.message }}
                        </div>
                    {% endif %}
                </div>
                <div class="cp-form-group">
                    {{ form_label(changePasswordForm.password.second) }}
                    {{ form_widget(changePasswordForm.password.second) }}
                    {% if changePasswordForm.password.second.vars.errors|length > 0 %}
                        <div class="cp-error">
                            {{ changePasswordForm.password.second.vars.errors|first.message }}
                        </div>
                    {% endif %}
                </div>
                <div class="cp-actions">
                    <button type="submit" class="cp-submit">
                        <i class="fa fa-check"></i>
                        Zapisz hasło
                    </button>
                </div>
            {{ form_end(changePasswordForm) }}
        </div>
    </div>
</body>
</html>

