<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRM POLA - Kod 2FA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #e5e7eb;
        }
        .card {
            background: #020617;
            border-radius: 16px;
            border: 1px solid #1f2937;
            padding: 24px 26px 22px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 24px 80px rgba(15, 23, 42, 0.75);
        }
        .header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        .icon {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #1d4ed8;
            color: #eff6ff;
        }
        .title {
            font-size: 16px;
            font-weight: 600;
        }
        .subtitle {
            font-size: 13px;
            color: #9ca3af;
            margin-bottom: 16px;
        }
        .form-group {
            margin-bottom: 14px;
        }
        .form-group label {
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 4px;
            display: block;
        }
        .form-group input {
            width: 100%;
            border-radius: 10px;
            border: 1px solid #1f2937;
            padding: 9px 12px;
            font-size: 14px;
            background: #020617;
            color: #f9fafb;
            text-align: center;
            letter-spacing: 0.25em;
        }
        .form-group input:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.8);
        }
        .btn-submit {
            width: 100%;
            margin-top: 4px;
            border-radius: 10px;
            border: none;
            padding: 9px 16px;
            font-size: 13px;
            font-weight: 600;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: #052e16;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-submit:hover {
            background: linear-gradient(135deg, #4ade80, #22c55e);
        }
        .error {
            margin-top: 6px;
            font-size: 12px;
            color: #fb7185;
        }
        @media (max-width: 480px) {
            body { align-items: flex-start; padding: 32px 16px; }
            .card { padding: 20px 16px; }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="header">
            <div class="icon"><i class="fa fa-shield-alt"></i></div>
            <div class="title">Wprowadź kod 2FA</div>
        </div>
        <div class="subtitle">
            Użyj aplikacji Google Authenticator lub innej aplikacji TOTP na telefonie, aby odczytać 6‑cyfrowy kod i potwierdzić logowanie.
        </div>

        <form action="{{ checkPathUrl ?? path(checkPathRoute) }}" method="post">
            <div class="form-group">
                <label for="_auth_code">Kod uwierzytelniający</label>
                <input type="text"
                       id="_auth_code"
                       name="{{ authCodeParameterName }}"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       pattern="[0-9]*"
                       autofocus
                       required>
            </div>
            {% if authenticationError %}
                <div class="error">
                    {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                </div>
            {% endif %}
            {% if displayTrustedOption %}
                <div class="form-group" style="margin-top: 8px; text-align: left;">
                    <label style="font-size: 12px; font-weight: 400;">
                        <input type="checkbox" name="{{ trustedParameterName }}" style="margin-right: 6px;">
                        Nie pytaj ponownie na tym urządzeniu
                    </label>
                </div>
            {% endif %}
            <button type="submit" class="btn-submit">
                <i class="fa fa-check"></i> Potwierdź
            </button>
            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}
        </form>
        {% if logoutPath is defined %}
            <div style="margin-top: 10px; text-align: center;">
                <a href="{{ logoutPath }}" style="font-size: 12px; color: #9ca3af; text-decoration: underline;">
                    Anuluj i wyloguj
                </a>
            </div>
        {% endif %}
    </div>
</body>
</html>

