<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRM POLA - Logowanie</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="icon" type="image/png" href="/pwpola-crm-logo.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
        }

        .login-wrapper {
            width: 100%;
            max-width: 400px;
            padding: 20px;
        }

        .login-logo {
            text-align: center;
            margin-bottom: 32px;
        }

        .login-logo .logo-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            background: #206bc4;
            border-radius: 12px;
            margin-bottom: 16px;
        }

        .login-logo .logo-icon i {
            color: #fff;
            font-size: 22px;
        }

        .login-logo h1 {
            font-size: 22px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 4px;
            letter-spacing: -0.5px;
        }

        .login-logo p {
            color: #626976;
            font-size: 14px;
            font-weight: 400;
        }

        .login-card {
            background: #ffffff;
            border: 1px solid #e6e7e9;
            border-radius: 8px;
            box-shadow: 0 1px 3px 0 rgba(0,0,0,.04), 0 1px 2px -1px rgba(0,0,0,.03);
            padding: 32px;
        }

        .login-card h2 {
            font-size: 18px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #1e293b;
            font-size: 13px;
        }

        .form-group input {
            width: 100%;
            padding: 9px 13px;
            border: 1px solid #e6e7e9;
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background: #fff;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
            outline: none;
        }

        .form-group input::placeholder {
            color: #94a3b8;
        }

        .form-group input:focus {
            border-color: #206bc4;
            box-shadow: 0 0 0 3px rgba(32, 107, 196, 0.1);
        }

        .error-message {
            background: #fce8e8;
            border: 1px solid #f5c2c2;
            color: #d63939;
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13.5px;
            font-weight: 500;
        }

        .btn-login {
            width: 100%;
            padding: 10px;
            background: #206bc4;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
            box-shadow: 0 1px 2px rgba(32, 107, 196, 0.2);
        }

        .btn-login:hover {
            background: #1a56a0;
            box-shadow: 0 2px 4px rgba(32, 107, 196, 0.3);
            transform: translateY(-1px);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .login-footer {
            text-align: center;
            margin-top: 24px;
            color: #94a3b8;
            font-size: 12px;
        }

        .login-footer i {
            margin-right: 4px;
        }

        @media (max-width: 480px) {
            body { align-items: flex-start; padding-top: 32px; }
            .login-wrapper { padding: 16px; }
            .login-card { padding: 24px 18px; }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-logo">
            <img src="/pwpola-crm-logo.png" width="56" style="margin-bottom: 12px;">
            <h1>CRM POLA</h1>
            <p>System zarządzania relacjami z klientami</p>
        </div>

        <div class="login-card">
            <h2>Zaloguj się do konta</h2>

            {% if error %}
                <div class="error-message">
                    <i class="fa fa-circle-exclamation"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="form-group">
                    <label for="inputEmail">Adres e-mail</label>
                    <input type="email" id="inputEmail" name="_username" value="{{ last_username }}"
                           required autofocus autocomplete="email" placeholder="np. jan@firma.pl">
                </div>

                <div class="form-group">
                    <label for="inputPassword">Hasło</label>
                    <input type="password" id="inputPassword" name="_password"
                           required autocomplete="current-password" placeholder="Wpisz hasło">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn-login" type="submit">
                    Zaloguj się
                </button>
            </form>
        </div>

        <div class="login-footer">
            <i class="fa fa-lock"></i> Połączenie zabezpieczone
        </div>
    </div>
</body>
</html>

